From 1e8b137f15d57d9ff87251baa2d7c990d5c460 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Fri, 30 Oct 2026 11:30:00 +0700
Subject: [PATCH 1/4] STD: add Kconfig SMART_TASK_DISTRIBUTOR Fair/Idle-only

Add SMART_TASK_DISTRIBUTOR behind kernel/Kconfig.preempt with
default y. The shim stays above deadline and never adds a new
scheduling class. Fair/Idle-only: fair and idle tasks prefer
housekeeping with SMT-aware idle selection and affinity-safe
fallback; deadline plus real-time pass through (SIS-deference, no
counters, LLC tier removed). EXT defers to SCX and the core check
is rq-wide and may over-skip. Default on keeps single image
behavior simple.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/Kconfig.preempt | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/kernel/Kconfig.preempt b/kernel/Kconfig.preempt
index f294dad43..1b206f3b3 100644
--- a/kernel/Kconfig.preempt
+++ b/kernel/Kconfig.preempt
@@ -197,3 +197,14 @@ config SCHED_CLASS_EXT
 	  For more information:
 	    Documentation/scheduler/sched-ext.rst
 	    https://github.com/sched-ext/scx
+
+config SMART_TASK_DISTRIBUTOR
+	bool "Smart Task Distributor routing shim"
+	default y
+	help
+	  Fair/Idle-only routing above the deadline class without adding
+	  a new scheduling class. Fair and idle tasks prefer housekeeping
+	  CPUs; deadline plus real-time pass through (SIS-deference, no
+	  counters). Steering uses SMT-aware idle selection with
+	  affinity-safe fallback; EXT defers to SCX, core rq-wide may
+	  over-skip, affinity/small honored, toggle via std_running.
-- 
