From 968db111ba3263845ba0575d2d3ef775e34dd10c Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Fri, 30 Oct 2026 13:15:31 +0700
Subject: [PATCH 1/5] STD: add Kconfig SMART_TASK_DISTRIBUTOR

Add SMART_TASK_DISTRIBUTOR behind kernel/Kconfig.preempt with
default y. The option refines wakeup placement chosen by existing
classes toward idle capacity. Fair tasks consult a tiny predictor;
real-time tasks accept only idle destinations; deadline tasks
respect a laxity veto; idle tasks remain in place. Default on
keeps single-image behavior simple.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/Kconfig.preempt | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/kernel/Kconfig.preempt b/kernel/Kconfig.preempt
index f294dad43..4a2521e68 100644
--- a/kernel/Kconfig.preempt
+++ b/kernel/Kconfig.preempt
@@ -197,3 +197,16 @@ config SCHED_CLASS_EXT
 	  For more information:
 	    Documentation/scheduler/sched-ext.rst
 	    https://github.com/sched-ext/scx
+
+config SMART_TASK_DISTRIBUTOR
+	bool "Smart Task Distributor routing shim"
+	default y
+	help
+	  Wakeup placement refinement toward idle capacity within the
+	  existing scheduler classes. Fair tasks consult a tiny fixed-point
+	  predictor; real-time tasks accept only idle destinations;
+	  deadline tasks respect a laxity veto; idle tasks remain in place.
+	  Candidates derive from the allowed mask, preferring a fully idle
+	  core, then any idle CPU, then a spread fallback. Steering
+	  responds to std_running with predictor sensitivity shaped by
+	  std_nn_thresh.
