From 79349d6797662fbd04e033c568cb24004557905 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: Fri, 30 Oct 2026 11:30:00 +0700
Subject: [PATCH 2/4] STD: wire build and sched.h include Fair/Idle-only

Wire std.o behind CONFIG_SMART_TASK_DISTRIBUTOR and include
std.h from sched.h. Keeps build parallel and keeps Fair/Idle-only
routing above deadline with no new scheduling class; steering uses
SMT-aware idle selection with SIS-deference for DL/RT.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 kernel/sched/Makefile | 1 +
 kernel/sched/sched.h  | 1 +
 2 files changed, 2 insertions(+)

diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
index b1f1a3670..ebc58c930 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -40,3 +40,4 @@ obj-y += core.o
 obj-y += fair.o
 obj-y += build_policy.o
 obj-y += build_utility.o
+obj-$(CONFIG_SMART_TASK_DISTRIBUTOR) += std.o
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 4c25fbe84..21266bc32 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -94,6 +94,7 @@ struct cpuidle_state;
 
 #include "cpupri.h"
 #include "cpudeadline.h"
+#include "std.h"
 
 /* task_struct::on_rq states: */
 #define TASK_ON_RQ_QUEUED	1
